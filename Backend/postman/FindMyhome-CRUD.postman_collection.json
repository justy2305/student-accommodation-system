    {
      "name": "5. Automatic decision (waits 2 minutes)",
      "item": [
        {
          "name": "Wait for the automatic review, then READ the decision",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{applicationId}}"
              ]
            },
            "description": "Waits about 2 minutes before sending. Postman shows the request as running while it waits."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The automatic review decides 2 minutes after applying",
                  "// (APPLICATION_REVIEW_SECONDS in the backend .env). Wait, then read the decision.",
                  "const waitMs = Number(pm.collectionVariables.get(\"reviewWaitSeconds\") || 125) * 1000;",
                  "setTimeout(() => {}, waitMs);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const a = pm.response.json().application;",
                  "pm.test(\"Automatically approved\", () => pm.expect(a.status).to.eql(\"Approved\"));",
                  "pm.test(\"Lease dates were set\", () => { pm.expect(a.lease_start).to.be.a(\"string\"); pm.expect(a.lease_end).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "READ the status history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{applicationId}}",
                "history"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const steps = pm.response.json().history.map((h) => h.status);",
                  "pm.test(\"Went Under Review, then Approved\", () => pm.expect(steps).to.eql([\"Under Review\", \"Approved\"]));"
                ]
              }
            }
          ]
        },
