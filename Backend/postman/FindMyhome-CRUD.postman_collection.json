          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has room types\", () => pm.expect(pm.response.json().accommodation.room_types.length).to.be.above(0));"
                ]
              }
            }
