    {
      "name": "2. Browse homes",
      "item": [
        {
          "name": "READ homes (search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accommodations/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accommodations",
                "search"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const homes = pm.response.json().accommodations;",
                  "pm.test(\"There are homes to apply for (run npm run db:seed if not)\", () => pm.expect(homes.length).to.be.above(0));",
                  "// Pick the first home with a room type that has space",
                  "const isOpen = (r) => r.is_available && r.available_rooms !== 0;",
                  "const home = homes.find((h) => (h.room_types || []).some(isOpen));",
                  "pm.test(\"A home has a free room type\", () => pm.expect(home).to.be.an(\"object\"));",
                  "pm.collectionVariables.set(\"accommodationId\", home.id);",
                  "pm.collectionVariables.set(\"roomType\", home.room_types.find(isOpen).room_type);"
                ]
              }
            }
          ]
        },
        {
          "name": "READ homes filtered (room type + price)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accommodations/search?roomType=Single&maxPrice=6000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accommodations",
                "search"
              ],
              "query": [
                {
                  "key": "roomType",
                  "value": "Single"
                },
                {
                  "key": "maxPrice",
                  "value": "6000"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only homes with a single room up to N$ 6000\", () => {",
                  "  for (const h of pm.response.json().accommodations) pm.expect(Number(h.price_from)).to.be.at.most(6000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "READ one home",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accommodations/{{accommodationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accommodations",
                "{{accommodationId}}"
