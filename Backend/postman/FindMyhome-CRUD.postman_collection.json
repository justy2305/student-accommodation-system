{
  "info": {
    "_postman_id": "b5131854-2c30-4c37-9eee-29bccec851a2",
    "name": "FindMyhome CRUD tests",
    "description": "Create, read, update and delete as a student: account, profile, applications and notifications, plus the automatic review (Pending \u2192 Under Review \u2192 Approved).\n\nBefore running: start the backend (npm run dev) and make sure the homes are seeded (npm run db:seed).\n\nRun it with Collection > Run. No login details needed: it registers its own test account and deletes it at the end. Folder 4 waits about 2 minutes for the automatic decision.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Account and profile",
      "item": [
        {
          "name": "CREATE account (register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"+264 81 000 0000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a fresh student account. Postman keeps the login cookie for the requests after it."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new test account every run, so the collection needs no setup",
                  "pm.collectionVariables.set(\"email\", `postman.${Date.now()}@findmyhome.test`);",
                  "pm.collectionVariables.set(\"password\", \"Postman12345\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Account has the new email\", () => pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get(\"email\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
